<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ibt_ai_provider_list" model="ir.ui.view">
        <field name="name">ibt.ai.provider.list</field>
        <field name="model">ibt.ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="transport"/>
                <field name="base_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_ibt_ai_provider_form" model="ir.ui.view">
        <field name="name">ibt.ai.provider.form</field>
        <field name="model">ibt.ai.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                    <button name="action_discover_models" type="object" string="Discover Models"
                            invisible="provider_kind != 'ollama'"/>
                    <button name="action_discover_voices" type="object" string="Discover Voices"
                            invisible="provider_kind != 'speech_gateway'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="transport"/>
                            <field name="provider_kind"/>
                            <field name="base_url" placeholder="https://api.example.com/v1"/>
                            <div colspan="2" class="text-muted" invisible="provider_kind != 'speech_gateway'">
                                Base URL of the gateway, e.g. https://speech.example.com/v1, and an API key created with
                                <code>ibt-admin keys add odoo</code> on the gateway.
                            </div>
                            <field name="api_key" password="True" placeholder="Type a key to store it (it is never shown again)"/>
                            <field name="api_key_set" invisible="1"/>
                            <div colspan="2" class="text-muted" invisible="not api_key_set">
                                A key is stored encrypted. Type a new key to replace it, or
                                <button name="action_remove_api_key" type="object" string="remove it" class="btn-link p-0 align-baseline"
                                        confirm="Remove the stored API key? Requests to this provider will be sent without a key."/>.
                            </div>
                        </group>
                        <group>
                            <field name="allow_private_network"/>
                            <field name="verify_ssl"/>
                            <field name="timeout"/>
                            <field name="send_embedding_dimensions" invisible="provider_kind == 'speech_gateway'"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models" name="models" invisible="provider_kind == 'speech_gateway'">
                            <field name="model_ids" context="{'default_provider_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model_type"/>
                                    <field name="name"/>
                                    <field name="label"/>
                                    <field name="embedding_dimensions" invisible="model_type != 'embedding'"/>
                                    <field name="supports_tools" optional="show"/>
                                    <field name="supports_vision" optional="hide"/>
                                    <field name="capabilities" optional="hide"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Voices" name="voices" invisible="provider_kind != 'speech_gateway'">
                            <field name="voice_ids" readonly="1">
                                <list create="0" delete="0" decoration-muted="not active">
                                    <field name="name"/>
                                    <field name="language"/>
                                    <field name="gender"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes"><field name="note"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ibt_ai_provider" model="ir.actions.act_window">
        <field name="name">IBT AI Providers</field>
        <field name="res_model">ibt.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_ibt_ai_provider" name="IBT AI Providers" parent="base.menu_custom"
              action="action_ibt_ai_provider" sequence="90" groups="base.group_system"/>
</odoo>
