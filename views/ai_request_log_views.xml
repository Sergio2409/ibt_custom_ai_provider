<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ibt_ai_request_log_list" model="ir.ui.view">
        <field name="name">ibt.ai.request.log.list</field>
        <field name="model">ibt.ai.request.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="outcome == 'failed'" decoration-warning="outcome == 'retrying'">
                <field name="create_date" string="Date"/>
                <field name="kind" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="provider_id"/>
                <field name="model_name"/>
                <field name="user_id" optional="show"/>
                <field name="agent_id" optional="hide"/>
                <field name="request_uuid" optional="hide"/>
                <field name="request_round" optional="hide"/>
                <field name="attempt" optional="show"/>
                <field name="outcome" widget="badge" decoration-success="outcome == 'success'"
                       decoration-warning="outcome == 'retrying'" decoration-danger="outcome == 'failed'"/>
                <field name="category"/>
                <field name="status_code" optional="hide"/>
                <field name="provider_request_id" optional="hide"/>
                <field name="duration"/>
                <field name="input_tokens" sum="Total" optional="show"/>
                <field name="output_tokens" sum="Total" optional="show"/>
                <field name="audio_seconds" sum="Total" optional="show"/>
                <field name="characters" sum="Total" optional="show"/>
                <field name="estimated_cost" sum="Total" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_ibt_ai_request_log_graph" model="ir.ui.view">
        <field name="name">ibt.ai.request.log.graph</field>
        <field name="model">ibt.ai.request.log</field>
        <field name="arch" type="xml">
            <graph string="AI Requests" type="bar" stacked="1">
                <field name="create_date" interval="hour"/>
                <field name="outcome"/>
            </graph>
        </field>
    </record>
    <record id="view_ibt_ai_request_log_pivot" model="ir.ui.view">
        <field name="name">ibt.ai.request.log.pivot</field>
        <field name="model">ibt.ai.request.log</field>
        <field name="arch" type="xml">
            <pivot string="AI Requests">
                <field name="provider_id" type="row"/>
                <field name="outcome" type="col"/>
                <field name="duration" type="measure"/>
                <field name="input_tokens" type="measure"/>
                <field name="output_tokens" type="measure"/>
                <field name="audio_seconds" type="measure"/>
                <field name="characters" type="measure"/>
                <field name="estimated_cost" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_ibt_ai_request_log_search" model="ir.ui.view">
        <field name="name">ibt.ai.request.log.search</field>
        <field name="model">ibt.ai.request.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="provider_id"/>
                <field name="model_name"/>
                <field name="user_id"/>
                <field name="request_uuid"/>
                <filter name="failed" string="Failed" domain="[('outcome', '=', 'failed')]"/>
                <filter name="retrying" string="Retrying" domain="[('outcome', '=', 'retrying')]"/>
                <separator/>
                <filter name="chat" string="Chat" domain="[('kind', '=', 'chat')]"/>
                <filter name="embedding" string="Embeddings" domain="[('kind', '=', 'embedding')]"/>
                <filter name="speech" string="Speech" domain="[('kind', 'in', ('transcription', 'speech', 'realtime'))]"/>
                <separator/>
                <filter name="since_yesterday" string="Since Yesterday"
                        domain="[('create_date', '>=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="create_date" string="Date" date="create_date"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_ibt_ai_request_log" model="ir.actions.act_window">
        <field name="name">IBT AI Request Log</field>
        <field name="res_model">ibt.ai.request.log</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="context">{'search_default_since_yesterday': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI requests in this period</p>
            <p>Every chat, embedding and speech gateway call is listed here for 90 days, without its content.</p>
        </field>
    </record>

    <record id="view_ai_session_ibt_queue_list" model="ir.ui.view">
        <field name="name">ai.session.ibt.queue.list</field>
        <field name="model">ai.session</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="ibt_ai_queued_at"
                  decoration-warning="ibt_ai_attempts > 0">
                <field name="ibt_ai_queued_at" string="Queued"/>
                <field name="ibt_ai_company_id" groups="base.group_multi_company"/>
                <field name="ibt_ai_provider_id"/>
                <field name="agent_id"/>
                <field name="request_user_id"/>
                <field name="request_round" optional="hide"/>
                <field name="ibt_ai_attempts" string="Retries"/>
                <field name="ibt_ai_next_attempt" string="Next Attempt"/>
            </list>
        </field>
    </record>
    <record id="action_ibt_ai_request_queue" model="ir.actions.act_window">
        <field name="name">IBT AI Request Queue</field>
        <field name="res_model">ai.session</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ai_session_ibt_queue_list"/>
        <field name="domain">[('loop_state', '=', 'waiting_model'), ('ibt_ai_provider_id', '!=', False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI request is waiting</p>
            <p>Requests waiting for a custom provider, oldest first. Retried requests show when they run next.</p>
        </field>
    </record>

    <menuitem id="menu_ibt_ai_request_log" name="IBT AI Request Log" parent="base.menu_custom"
              action="action_ibt_ai_request_log" sequence="91" groups="base.group_system"/>
    <menuitem id="menu_ibt_ai_request_queue" name="IBT AI Request Queue" parent="base.menu_custom"
              action="action_ibt_ai_request_queue" sequence="92" groups="base.group_system"/>
</odoo>
