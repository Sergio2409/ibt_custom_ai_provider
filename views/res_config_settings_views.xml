<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_ibt_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ibt.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="IBT AI Provider" name="ibt_ai_provider_settings">
                    <setting string="Custom AI provider" help="Route Odoo AI requests through the provider selected for this company.">
                        <field name="ibt_ai_enabled"/>
                        <div class="content-group" invisible="not ibt_ai_enabled">
                            <div class="row mt16"><label for="ibt_ai_provider_id" class="col-lg-4 o_light_label"/><field name="ibt_ai_provider_id" required="ibt_ai_enabled" options="{'no_quick_create': True}"/></div>
                            <div class="row mt16"><label for="ibt_ai_chat_model_id" class="col-lg-4 o_light_label"/><field name="ibt_ai_chat_model_id" required="ibt_ai_enabled" options="{'no_quick_create': True}"/></div>
                            <div class="row mt16"><label for="ibt_ai_reasoning_model_id" class="col-lg-4 o_light_label"/><field name="ibt_ai_reasoning_model_id" options="{'no_quick_create': True}"/></div>
                            <div class="row mt16"><label for="ibt_ai_embedding_provider_id" class="col-lg-4 o_light_label"/><field name="ibt_ai_embedding_provider_id" options="{'no_quick_create': True}"/></div>
                            <div class="row mt16"><label for="ibt_ai_embedding_model_id" class="col-lg-4 o_light_label"/><field name="ibt_ai_embedding_model_id" options="{'no_quick_create': True}" invisible="not ibt_ai_embedding_provider_id"/></div>
                            <div class="mt16"><button name="%(action_ibt_ai_provider)d" type="action" string="Manage providers and models" class="btn-link" icon="oi-arrow-right"/></div>
                            <div><button name="%(action_ibt_ai_request_log)d" type="action" string="Request log" class="btn-link" icon="oi-arrow-right"/></div>
                            <div><button name="%(action_ibt_ai_request_queue)d" type="action" string="Request queue" class="btn-link" icon="oi-arrow-right"/></div>
                        </div>
                    </setting>
                    <setting string="Speech-to-text" help="Transcribe AI chat voice messages and call recordings with your IBT Speech Gateway instead of Odoo's IAP service.">
                        <field name="ibt_speech_enabled"/>
                        <div class="content-group" invisible="not ibt_speech_enabled">
                            <div class="row mt16"><label for="ibt_speech_provider_id" class="col-lg-4 o_light_label"/><field name="ibt_speech_provider_id" required="ibt_speech_enabled" options="{'no_quick_create': True}"/></div>
                            <div class="row mt16"><label for="ibt_speech_correction" class="col-lg-4 o_light_label"/><field name="ibt_speech_correction"/></div>
                            <div class="row mt16"><label for="ibt_speech_realtime" class="col-lg-4 o_light_label"/><field name="ibt_speech_realtime"/></div>
                            <div class="row mt16"><label for="ibt_speech_voice_replies" class="col-lg-4 o_light_label"/><field name="ibt_speech_voice_replies"/></div>
                            <div class="row mt16" invisible="not ibt_speech_voice_replies"><label for="ibt_speech_voice_mode" class="col-lg-4 o_light_label"/><field name="ibt_speech_voice_mode"/></div>
                            <div class="row mt16" invisible="not ibt_speech_voice_replies"><label for="ibt_speech_voice_es_id" class="col-lg-4 o_light_label"/><field name="ibt_speech_voice_es_id" options="{'no_create': True, 'no_open': True}" placeholder="ef_dora"/></div>
                            <div class="row mt16" invisible="not ibt_speech_voice_replies"><label for="ibt_speech_voice_en_id" class="col-lg-4 o_light_label"/><field name="ibt_speech_voice_en_id" options="{'no_create': True, 'no_open': True}" placeholder="af_heart"/></div>
                            <div class="mt8" invisible="not ibt_speech_voice_replies"><button name="action_ibt_discover_voices" type="object" string="Load voices from the gateway" class="btn-link" icon="oi-arrow-right"/></div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
