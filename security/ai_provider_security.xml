<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ibt_ai_provider_system" model="ir.rule">
        <field name="name">AI providers: settings administrators only</field>
        <field name="model_id" ref="model_ibt_ai_provider"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_ibt_ai_provider_model_system" model="ir.rule">
        <field name="name">AI provider models: settings administrators only</field>
        <field name="model_id" ref="model_ibt_ai_provider_model"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>

