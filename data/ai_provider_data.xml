<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="provider_openai" model="ibt.ai.provider">
        <field name="name">OpenAI</field>
        <field name="transport">openai</field>
        <field name="base_url">https://api.openai.com/v1</field>
        <field name="sequence">10</field>
    </record>
    <record id="provider_anthropic" model="ibt.ai.provider">
        <field name="name">Anthropic Claude</field>
        <field name="transport">anthropic</field>
        <field name="base_url">https://api.anthropic.com/v1</field>
        <field name="sequence">20</field>
        <field name="note">Anthropic supports chat and tool calling but does not provide embeddings.</field>
    </record>
    <record id="provider_ollama" model="ibt.ai.provider">
        <field name="name">Ollama</field>
        <field name="transport">openai</field>
        <field name="provider_kind">ollama</field>
        <field name="base_url">http://localhost:11434/v1</field>
        <field name="allow_private_network" eval="True"/>
        <field name="send_embedding_dimensions" eval="False"/>
        <field name="sequence">30</field>
        <field name="note">Replace localhost when Odoo runs in a container. Add the exact model IDs installed in Ollama.</field>
    </record>
</odoo>
